# Local-only password. Replace this placeholder in your ignored .env.
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=55432
# JWT paths are exported from the repository root after generating local keys.
# See docs/LOCAL_DEVELOPMENT.md. Keep signing keys out of this template.
JWT_ISSUER=https://ledgerflow.local

# Optional Stripe Sandbox integration. Never use live keys.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLAID_ENABLED=false
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_WEBHOOK_URL=
# Generate with: openssl rand -base64 32
PLAID_TOKEN_ENCRYPTION_KEY=
